generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant migration, phase A: nullable for now so the live DB can be
// backfilled in a separate step before this becomes required — see
// scripts/backfill-household.mjs. Every model below gets the same treatment.
model Household {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
  // null for email/Telegram-only households — only the original household
  // (backfilled as id 1) keeps PIN login going forward.
  pinHash   String?
  authMode  String   @default("email") // "pin" | "email" | "telegram" — informational only today (nothing branches on it yet), records how the household first signed up
  createdAt DateTime @default(now())
  // null = onboarding wizard not completed yet (empty categories, no PIN
  // decision made). Set once by POST /api/onboarding/complete. Household #1
  // and any household that predates the onboarding flow is backfilled to
  // now() so it's never sent through the wizard retroactively.
  onboardedAt DateTime?
  // ISO 4217 alpha code (e.g. "NOK", "PLN") — the household's own display/
  // conversion-target currency, chosen once at onboarding. Defaults to NOK
  // so household #1 (predates this field) and any pre-onboarding row keep
  // their existing behavior unchanged. See lib/currencies.ts for the
  // curated code/numeric/symbol list this must stay in sync with.
  currency String @default("NOK")

  users              User[]
  categories         Category[]
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  monthlyPlans       MonthlyPlan[]
  lockout            HouseholdLockout?
}

// Per-household brute-force counter — mirrors AuthLockout's atomic-UPDATE
// approach (see that model's own comment) but keyed by household instead of
// a single global singleton, since PIN failures for one household must never
// affect another's lockout state once more than one household exists.
model HouseholdLockout {
  householdId Int       @id
  household   Household @relation(fields: [householdId], references: [id])
  failCount   Int       @default(0)
  lockedUntil BigInt    @default(0)
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  householdId        Int?
  household          Household?           @relation(fields: [householdId], references: [id])
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  createdAt          DateTime             @default(now())

  // Monobank integration (see lib/crypto.ts). monoTokenEnc is the personal
  // API token, AES-256-GCM encrypted — never stored or logged in plaintext.
  // monoWebhookSecret is a per-user random path segment for the webhook
  // receiver URL, so the real bank token is never exposed via a URL.
  monoTokenEnc      String? @unique
  monoWebhookSecret String? @unique
  monoAccountId     String?
  monoCategoryRules MonoCategoryRule[]
  // Hard floor for monobank/sync's LOOKBACK_DAYS window, same idea as
  // sbSyncFloor below for SpareBank 1 — sync will never fetch a transaction
  // dated on or before this day, no matter what the rolling lookback window
  // would otherwise compute. Set explicitly (via a one-off script, not app
  // UI, same convention as sbSyncFloor) after the user has manually
  // reconciled everything through a given date.
  monoSyncFloor DateTime?

  // SpareBank 1 (via Enable Banking, PSD2/Berlin Group AISP) integration.
  // sbSessionEnc is the Enable Banking session_id, AES-256-GCM encrypted
  // (see lib/crypto.ts) — it's a bearer credential granting read access to
  // real bank data, same sensitivity class as monoTokenEnc. sbValidUntil is
  // the consent expiry Enable Banking returns from POST /sessions; past it,
  // the session is dead and the user must reconnect (there is no silent
  // refresh in the restricted-mode flow this app uses).
  sbSessionEnc  String?   @unique
  sbValidUntil  DateTime?
  // One consent (sbSessionEnc) can cover MULTIPLE real accounts at the same
  // bank — confirmed live 2026-08-01: Enable Banking returned 2 accounts for
  // one SpareBank 1 consent (a checking account AND a separate savings
  // "Pillow" account), but the original single-account fields below only
  // ever captured accounts[0], so the second account's existence, balance,
  // and transactions were completely invisible to the app. See
  // SparebankAccount, one row per real account.
  sparebankAccounts SparebankAccount[]

  // Unattended (cron-triggered) sync — opt-in, off by default. Automatically
  // reaching into someone's bank without a click each time is a consent
  // question, not just a convenience toggle, so this is never flipped true
  // implicitly by connecting a bank. sbLastAutoSyncAt is separate from each
  // SparebankAccount's own lastSyncedAt (which any sync, manual or auto,
  // advances) specifically so the cron route can enforce its own minimum gap
  // between runs — a retry or a double-fire (e.g. the two DST-candidate cron
  // slots both matching in the same run) must never burn two calls from
  // Enable Banking's tiny ~4/day unattended quota. sbSyncFailCount drives the
  // "consent probably expired, notify the user" Telegram alert — reset on
  // any successful auto-sync.
  sbAutoSync       Boolean   @default(false)
  sbLastAutoSyncAt DateTime?
  sbSyncFailCount  Int       @default(0)

  // Telegram Login Widget auth (see lib/telegramAuth.ts). telegramId is
  // Telegram's own numeric user id, stored as a string (safer than Int for
  // an externally-issued id we never do arithmetic on). email can still be
  // set unverified via Telegram registration (a claimed identifier, not a
  // proven one) — emailVerifiedAt is null in that case. MT Ф4's magic-link
  // flow is the only thing that ever sets emailVerifiedAt, and only login
  // logic that requires proof (not just presence) of email ownership may
  // treat a row as "this email really belongs here" — see
  // api/auth/magic-link/verify/route.ts, which clears a stale unverified
  // claim on any OTHER row before minting a new-registration token, so a
  // false claim typed into the Telegram form can never intercept someone
  // else's real magic-link login.
  email             String?   @unique
  emailVerifiedAt   DateTime?
  telegramId        String?   @unique
  telegramUsername  String?
  telegramFirstName String?
  telegramPhotoUrl  String?

  // MT Ф4: was a global @@unique on name alone — blocked two different
  // households from ever both having a member with the same first name.
  // householdId is still nullable (phase A note above), but every real row
  // already has one since the phase-A backfill, so this doesn't loosen
  // anything for existing data.
  @@unique([householdId, name])
}

// One real bank account under a SpareBank 1 (Enable Banking) consent — a
// household member can have several (checking + a named savings "pillow"
// account, confirmed live). syncEnabled decides whether this specific
// account's own transactions get pulled into the household's budget at all
// — off by default for every account except the first one discovered at
// connect time (mirrors the old single-account behavior exactly for anyone
// with just one account), so turning on a second account's own sync is a
// deliberate opt-in, not automatic. Even accounts with syncEnabled=false are
// still useful: identification/iban lets sparebankIngest.ts recognize a
// transfer TO or FROM this account inside another account's transaction feed
// and mark it as a budget-neutral internal transfer instead of income/expense.
model SparebankAccount {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  accountUid     String    @unique // Enable Banking's own account uid
  iban           String?
  // BBAN-style local account number (Enable Banking's account_id.other.identification)
  // — SpareBank 1 transactions carry this on creditor_account/debtor_account,
  // NOT always the IBAN, so this is the more reliable transfer-matching key.
  identification String?
  // Defaults to whatever the bank itself calls the account (confirmed live:
  // SpareBank 1 returns "BRUKSKONTO" / "Pillow" via GET /accounts/{uid}/details's
  // `details` field) — a real, bank-assigned nickname beats a generic
  // "Рахунок 2" guess. User-editable afterward.
  label          String
  syncEnabled    Boolean   @default(false)
  lastSyncedAt   DateTime?
  // Same purpose as the old User.sbSyncFloor — never let syncEnabled's own
  // rolling overlap window cross below this date.
  syncFloor      DateTime?
  balanceAmount   Float?
  balanceCurrency String?
  balanceFetchedAt DateTime?
  createdAt      DateTime  @default(now())

  // Ф2 (deferred 2026-08-02, done 2026-08-29): the explicit "this real bank
  // account IS a tracked savings pool" fact — e.g. Подушка -> "Фінансова
  // подушка". Before this field existed, sparebankIngest.ts had to GUESS the
  // same fact four different ways every time a same-person transfer synced:
  // (1) which SparebankAccount has the higher id ("selfIsPoolSide", an
  // ordinal proxy, correct only because Основний happened to connect
  // first), (2) which of the transfer's two legs happened to sync FIRST
  // (order, not meaning, decided which row survived as the real entry),
  // (3) a MonoCategoryRule text match on the counterparty's name (fragile —
  // the same bug class as feedback_generalize_category_rules' name-based
  // rules generally), and (4) savingsWithdrawal doing double duty as both
  // the math direction AND the display sign, which silently inverted
  // against each other (found live 2026-08-29: a withdrawal rendered "+"
  // green while the total correctly counted it negative). Every bug in this
  // area since 2026-07-31 was a symptom of this fact not being recorded
  // anywhere. Null for an ordinary (non-pool) account like "Основний".
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id])
}

// MT Ф4: rate-limits magic-link email requests before any household/user
// exists to hang a lockout row off of (HouseholdLockout needs a household).
// Rows are cheap and never need cleanup beyond what the rate-limit window
// itself makes irrelevant (old rows just age out of the lookback query).
model MagicLinkRequest {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Learned merchant → category mappings, populated ONLY from manual
// corrections a user makes to an imported Monobank transaction (never from
// Claude's own guesses — otherwise a bad guess could poison future guesses
// for the same merchant). Checked before MCC lookup and before calling
// Claude, so a merchant seen once and corrected is never re-guessed.
model MonoCategoryRule {
  id          Int      @id @default(autoincrement())
  userId      Int
  merchantKey String   // normalized: lowercase, trimmed, collapsed whitespace
  categoryId  Int
  hitCount    Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, merchantKey])
}

model Category {
  id                 Int                  @id @default(autoincrement())
  name               String
  type               String
  color              String               @default("#6366F1")
  icon               String               @default("circle")
  isActive           Boolean              @default(true)
  householdId        Int?
  household          Household?           @relation(fields: [householdId], references: [id])
  transactions       Transaction[]
  plans              MonthlyPlan[]
  recurringTemplates RecurringTemplate[]
  monoCategoryRules  MonoCategoryRule[]
  sparebankAccounts  SparebankAccount[]

  // Phase C of the multi-tenant migration: uniqueness scoped per household,
  // not global — a global @@unique([name, type]) meant two different
  // households could never both have a category named "Їжа", which defeats
  // the entire point of tenant isolation. householdId is still nullable
  // (phase A note) but Postgres treats NULL as distinct from any other value
  // in a unique index, so this doesn't regress anything for not-yet-migrated
  // rows — there are none, everything was backfilled in phase A.
  @@unique([householdId, name, type])
}

model Transaction {
  id                  Int                @id @default(autoincrement())
  date                DateTime
  categoryId          Int
  amount              Float
  details             String             @default("")
  userId              Int?
  householdId         Int?
  household           Household?         @relation(fields: [householdId], references: [id])
  createdAt           DateTime           @default(now())
  recurringTemplateId Int?
  category            Category           @relation(fields: [categoryId], references: [id])
  user                User?              @relation(fields: [userId], references: [id])
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])

  // Which subsystem wrote this row — manual entry, Excel plan import,
  // recurring-template apply, or Monobank webhook. Lets Ф5's double-count
  // guard tell "two independent writers recorded the same real payment"
  // apart from "two genuinely separate transactions."
  source String @default("manual")

  // Only meaningful when category.type === "savings" — see
  // lib/validate.ts's savingsAmount() for the actual math. A savings
  // DEPOSIT (the default, false — the only meaning "savings" had before
  // this field existed) sets money aside and reduces available balance,
  // same as always. A WITHDRAWAL (true) is money coming back out of that
  // pot into general spending money: it increases available balance and
  // shrinks the pot's own running total, instead of being counted as a
  // second deduction on top of the deposit that put the money there.
  // Found live 2026-07-27: a bank-learned category rule filed an internal
  // transfer between Женя's own checking and savings sub-accounts under
  // "Фінансова подушка" in BOTH directions with no distinction, silently
  // double-subtracting every withdrawal from the household's balance.
  savingsWithdrawal Boolean @default(false)

  // Monobank fields — all null for non-mono rows.
  monoStatementId    String? @unique // dedup key: Monobank's own transaction id
  monoMerchant       String?         // raw merchant description, for MonoCategoryRule matching
  monoMcc            Int?            // merchant category code, first-pass category guess
  monoAmountOriginal Float?          // original amount in the card's currency (before FX)
  monoCurrency       String?         // ISO code of the original currency, e.g. "UAH"
  fxRate             Float?          // rate applied at import time (original * fxRate = amount)

  // Set when a NEW mono transaction lands in the same category+month as an
  // existing recurring/import row with a similar amount — the same shape of
  // bug already found once this session (Excel import + recurring both
  // silently writing "rent" for the same month). Never auto-blocks the
  // write (blocking risks losing a real transaction that's just coincidentally
  // similar); just flags it for a human to glance at in the transactions list.
  possibleDuplicateOf Int?

  // Dedup key for voice-logged transactions — Telegram's voice message
  // file_unique_id. NULL for every other source, same pattern as
  // monoStatementId. A DB-level unique constraint, not an in-memory "seen"
  // set, so it survives across serverless invocations.
  telegramMessageId String? @unique

  // SpareBank 1 (Enable Banking) fields — all null for non-sparebank rows.
  // sbTransactionId is Enable Banking's own transaction/entry reference —
  // NOT globally unique the way monoStatementId is. Confirmed live: its
  // value is "<date>-<sequence-number-within-day>" (e.g. "2026-07-21-0"),
  // a per-account daily sequence, not a bank-wide hash. A bare @unique here
  // let two different users' first transaction of the same day collide on
  // the same key, silently dropping whichever one synced second as a false
  // "duplicate" — found during security review 2026-07-22. Uniqueness is
  // scoped per user below instead. No FX fields needed — SpareBank 1 is
  // already NOK, the app's own currency.
  sbTransactionId String?
  sbCounterparty  String? // debtor/creditor name, for future category-rule matching

  // "Doesn't count toward any budget total" — two distinct real-world cases,
  // both structural, neither a code-level guess:
  // 1. A transfer between two accounts the SAME PERSON owns (SpareBank1's
  //    checking <-> "pillow" savings, or Monobank between household
  //    members' own connected accounts) — the money didn't appear or
  //    disappear, it just moved. Detected automatically: lib/sparebankIngest.ts
  //    matches the counterparty's account id/IBAN against the user's other
  //    known SparebankAccount rows; lib/monoIngest.ts's findMonoTransferMatch
  //    matches by exact amount + opposite direction on the OTHER household
  //    member's own connected mono account (Monobank exposes no account id
  //    to match on directly, unlike SpareBank).
  // 2. A real expense/income that's already accounted for through a
  //    DIFFERENT channel entirely (e.g. a work trip cost reimbursed
  //    separately) — filed under whatever category is honest for what
  //    actually happened (so it still reads correctly in the transaction
  //    list), NOT the transfer category; only this flag, not the category,
  //    is what pulls it out of the totals. Currently hand-set per row (found
  //    2026-08-01), no automatic detection — there's no structural signal
  //    for "already counted elsewhere" the way there is for a same-person
  //    account match.
  // Every budget sum (stats.ts, analytics.ts) must skip isTransfer rows
  // entirely regardless of category — see lib/validate.ts's
  // isBudgetRelevant(). Independent from savingsWithdrawal above, which
  // still covers manually-entered cushion movements (cash/crypto) with no
  // bank-side signal to detect them from.
  isTransfer Boolean @default(false)

  @@index([date])
  // Guards against the recurring/apply race: concurrent requests applying the
  // same template for the same month could both pass the "already applied"
  // check before either commits. NULL recurringTemplateId (regular manual
  // transactions) never conflicts with itself under Postgres unique-index
  // semantics, so this only constrains recurring-generated rows.
  @@unique([recurringTemplateId, date])
  // sbTransactionId is only unique WITHIN one user's own account — see the
  // field's own comment. NULL userId never conflicts with itself under
  // Postgres unique-index semantics, and every sparebank row always has a
  // real userId (ingestTransaction requires it), so this never loosens
  // anything for real data.
  @@unique([userId, sbTransactionId])
}

model RecurringTemplate {
  id           Int           @id @default(autoincrement())
  name         String
  amount       Float
  categoryId   Int
  userId       Int
  details      String        @default("")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  householdId  Int?
  household    Household?    @relation(fields: [householdId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model AppSetting {
  key   String @id
  value String
}

// Separate from AppSetting so the failure counter can be incremented with a
// single atomic `UPDATE ... SET "failCount" = "failCount" + 1` — Postgres
// serializes concurrent UPDATEs on the same row via a row-level lock, so
// every failed attempt is guaranteed to count exactly once even under
// concurrent requests. A read-then-write on a JSON string (the previous
// approach) let concurrent requests read the same stale value and undercount.
model AuthLockout {
  id          Int    @id @default(1)
  failCount   Int    @default(0)
  lockedUntil BigInt @default(0)
}

model MonthlyPlan {
  id            Int        @id @default(autoincrement())
  year          Int
  month         Int
  categoryId    Int
  plannedAmount Float      @default(0)
  notes         String     @default("")
  householdId   Int?
  household     Household? @relation(fields: [householdId], references: [id])
  category      Category   @relation(fields: [categoryId], references: [id])

  @@unique([year, month, categoryId])
}
