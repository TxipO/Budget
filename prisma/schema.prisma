generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  createdAt          DateTime             @default(now())
}

model Category {
  id                 Int                  @id @default(autoincrement())
  name               String
  type               String
  color              String               @default("#6366F1")
  icon               String               @default("circle")
  isActive           Boolean              @default(true)
  transactions       Transaction[]
  plans              MonthlyPlan[]
  recurringTemplates RecurringTemplate[]

  @@unique([name, type])
}

model Transaction {
  id                  Int                @id @default(autoincrement())
  date                DateTime
  categoryId          Int
  amount              Float
  details             String             @default("")
  userId              Int?
  createdAt           DateTime           @default(now())
  recurringTemplateId Int?
  category            Category           @relation(fields: [categoryId], references: [id])
  user                User?              @relation(fields: [userId], references: [id])
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])

  @@index([date])
  // Guards against the recurring/apply race: concurrent requests applying the
  // same template for the same month could both pass the "already applied"
  // check before either commits. NULL recurringTemplateId (regular manual
  // transactions) never conflicts with itself under Postgres unique-index
  // semantics, so this only constrains recurring-generated rows.
  @@unique([recurringTemplateId, date])
}

model RecurringTemplate {
  id           Int           @id @default(autoincrement())
  name         String
  amount       Float
  categoryId   Int
  userId       Int
  details      String        @default("")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  category     Category      @relation(fields: [categoryId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model AppSetting {
  key   String @id
  value String
}

// Separate from AppSetting so the failure counter can be incremented with a
// single atomic `UPDATE ... SET "failCount" = "failCount" + 1` — Postgres
// serializes concurrent UPDATEs on the same row via a row-level lock, so
// every failed attempt is guaranteed to count exactly once even under
// concurrent requests. A read-then-write on a JSON string (the previous
// approach) let concurrent requests read the same stale value and undercount.
model AuthLockout {
  id          Int    @id @default(1)
  failCount   Int    @default(0)
  lockedUntil BigInt @default(0)
}

model MonthlyPlan {
  id            Int      @id @default(autoincrement())
  year          Int
  month         Int
  categoryId    Int
  plannedAmount Float    @default(0)
  notes         String   @default("")
  category      Category @relation(fields: [categoryId], references: [id])

  @@unique([year, month, categoryId])
}
