# Copy to .env. Postgres connection string (Neon, Vercel Postgres, or any Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Initial PIN for app access, used until first change via Settings (stored in DB after that)
APP_PIN="0000"
# Static secret for signing session cookies (random hex, generate once). Unset = auth disabled
AUTH_SECRET="change-me-random-hex"
