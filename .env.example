# Copy to .env. Postgres connection string (Neon, Vercel Postgres, or any Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Initial PIN for app access, used until first change via Settings (stored in DB after that)
APP_PIN="0000"
# Static secret for signing session cookies (random hex, generate once). Unset = auth disabled
AUTH_SECRET="change-me-random-hex"

# Resend API key for sending magic-link login emails (resend.com). Unset =
# dev fallback that logs the link to the server console instead of sending —
# fine for local testing, but real production sending needs this set.
RESEND_API_KEY=""
# Sender address for magic-link emails. Resend's shared sandbox domain works
# for testing; a verified custom domain is needed to send to arbitrary
# recipients in production.
EMAIL_FROM="Budget <onboarding@resend.dev>"
